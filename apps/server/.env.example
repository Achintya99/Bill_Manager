# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Shared secret the mobile app sends in the x-app-token header. Pick any long random string.
APP_TOKEN=
# Optional overrides
PORT=8787
EXTRACTION_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
EXTRACTION_EFFORT=medium
# Set to "mock" to return a sample receipt without calling the API (UI development).
EXTRACTOR=
